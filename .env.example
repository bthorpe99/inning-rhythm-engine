PORT=8787
# Optional. When absent, the app clearly labels demo prices as SAMPLE.
ODDS_API_KEY=
# Comma-separated bookmaker regions supported by your provider.
ODDS_REGIONS=us
INCLUDE_INNING_ODDS=true
# Minimum model edge required for an alert, expressed as probability points.
MIN_EDGE=0.04
# Polling is off by default. Set to a value >= 60 for periodic refreshes.
POLL_SECONDS=0
# Optional YYYY-MM-DD override for historical testing. Defaults to today.
AS_OF_DATE=
